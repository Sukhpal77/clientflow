{
  "name": "clientflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js client/tests/*.test.js",
    "migrate": "node server/db/migrate.js",
    "build:demo": "vite build --mode demo --configLoader native",
    "format": "prettier --write client server e2e scripts docs *.json *.js *.yml *.md",
    "format:check": "prettier --check client server e2e scripts docs *.json *.js *.yml *.md",
    "preview:demo": "vite preview --mode demo --configLoader native --host 127.0.0.1",
    "test:postgres": "node server/tests/postgres-runner.js",
    "test:api": "node --test --test-concurrency=1 server/tests/*.test.js",
    "test:ui": "node --test client/tests/*.test.js",
    "seed": "node server/db/seed.js",
    "playwright:install": "node scripts/run-playwright.mjs install",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:report": "playwright show-report",
    "verify": "npm test && npm run test:postgres && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
